# Local TEGAKI Card/Report handoff runtime; never commit this IPC data.
/.tegaki-handoff/

# Repository-wide local dependencies, build output, logs, and temporary data.
# Keep project source directories visible; these patterns cover generated/local
# storage regardless of which product area owns it.
**/node_modules/
**/dist/
**/*.log
**/*.tmp
**/.cache/
**/cache/
**/temp/
開発用資料保管庫/

# Repository-wide payload guardrails.  Intentional exceptions must be
# reviewed explicitly before being added to the public tree.
**/*.safetensors*
**/*.ckpt
**/*.pt*
**/*.pth
**/*.onnx*
**/*.bin
**/*.7z*
**/*.zip
**/*.rar*
**/*.tar
**/*.tar.gz
**/*.whl*
**/*.msi
**/*.pkg*
**/*.dmg
**/*.exe*
**/*.dll
**/*.pyd*
**/*.so
**/*.dylib*
**/*.node
**/*.jar
**/.venv/
**/venv/
**/python_embeded/
